#!/usr/bin/env bash
# Low-token helpers for the WDD coordinator. Prefer these over raw orca dumps.
#
#   wdd boot --plan PLAN --agent AGENT […]
#   wdd models [--agent NAME] [--ids-only]
#   wdd agents [--json]          # brief auth map (not full account list)
#   wdd ready --run RUN_ID       # ready tasks only
#   wdd complete --run RUN_ID --task TASK_ID [--start-next]
#   wdd review --run RUN_ID --task TASK_ID   # dispatch cross-agent review
#   wdd check --run RUN_ID       # 1-line event summary
#   wdd workers --run RUN_ID     # compact worker rows
#   wdd status --run RUN_ID      # compact run & worker summary (<6 lines)
#   wdd send --run RUN_ID --to DEST --subject SUBJ [--body TEXT]
#   wdd reply --id MSG_ID --body TEXT
#   wdd gate create|resolve|list # decision gates
#   wdd show --dispatch ID       # compact worker state (<5 lines)
#   wdd read --dispatch ID       # bounded worker output tail (<25 lines)
#   wdd release --dispatch ID    # release worker terminal
#   wdd task-list --run RUN_ID   # compact task listing
#   wdd config [set|get|list]    # persistent or local defaults
#   wdd path                     # print this skill's scripts dir
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPTS="$SKILL_DIR/scripts"
ORCA_BIN="${ORCA_CLI_COMMAND:-orca}"

cmd="${1:-}"
[[ -n "$cmd" ]] || { sed -n '2,21p' "$0"; exit 2; }
shift || true

case "$cmd" in
  path) echo "$SCRIPTS" ;;
  boot) exec bash "$SCRIPTS/wdd-boot.sh" "$@" ;;
  models) exec bash "$SCRIPTS/list-models.sh" "$@" ;;
  config) exec bash "$SCRIPTS/wdd-config.sh" "$@" ;;
  agents) exec bash "$SCRIPTS/agents-brief.sh" "$@" ;;
  ready) exec bash "$SCRIPTS/ready-brief.sh" "$@" ;;
  complete|task-update) exec bash "$SCRIPTS/complete-brief.sh" "$@" ;;
  review) exec bash "$SCRIPTS/review-brief.sh" "$@" ;;
  check) exec bash "$SCRIPTS/check-brief.sh" "$@" ;;
  workers) exec bash "$SCRIPTS/workers-brief.sh" "$@" ;;
  status) exec bash "$SCRIPTS/status-brief.sh" "$@" ;;
  send) exec bash "$SCRIPTS/send-brief.sh" "$@" ;;
  reply) exec bash "$SCRIPTS/reply-brief.sh" "$@" ;;
  gate) exec bash "$SCRIPTS/gate-brief.sh" "$@" ;;
  show|worker-show) exec bash "$SCRIPTS/worker-show-brief.sh" "$@" ;;
  read|worker-read) exec bash "$SCRIPTS/worker-read-brief.sh" "$@" ;;
  release) exec bash "$SCRIPTS/release-brief.sh" "$@" ;;
  task-list) exec bash "$SCRIPTS/task-list-brief.sh" "$@" ;;
  -h|--help|help) sed -n '2,21p' "$0" ;;
  *) echo "unknown command: $cmd (try: boot models agents ready complete review check workers status send reply gate show read release task-list config path)" >&2; exit 2 ;;
esac
